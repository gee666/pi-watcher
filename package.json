{
  "name": "oira666_pi-watcher",
  "version": "0.0.7",
  "description": "A persistent side-agent conversation for observing and steering your running Pi agent.",
  "type": "module",
  "license": "MIT",
  "author": "gee666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gee666/pi-watcher.git"
  },
  "homepage": "https://github.com/gee666/pi-watcher#readme",
  "bugs": {
    "url": "https://github.com/gee666/pi-watcher/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "watcher"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/",
    "README.md",
    "EVERGREEN.md",
    "LICENSE",
    "watcher-settings.example.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "pretest": "npm install @earendil-works/pi-ai@latest @earendil-works/pi-agent-core@latest @earendil-works/pi-coding-agent@latest @earendil-works/pi-tui@latest --save-dev --ignore-scripts && npm run check",
    "test": "node --test test/*.test.ts test/*.test.cjs",
    "test:evergreen": "node test/evergreen.mjs",
    "prepack": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.4.0",
    "@earendil-works/pi-ai": ">=1.4.0",
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
